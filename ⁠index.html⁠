<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aquila – Genuss ohne Grenzen</title>
    <!-- Google Fonts & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-main: #0f1115;
            --bg-card: #181b20;
            --bg-input: #22262e;
            --accent: #e65100;
            --accent-hover: #ff6d00;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border: #2d333d;
            --radius: 12px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background-color: var(--bg-main); color: var(--text-main); line-height: 1.6; }

        /* Navigation */
        nav {
            display: flex; justify-content: space-between; align-items: center;
            padding: 1.2rem 8%; background: rgba(15, 17, 21, 0.9);
            backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000;
            border-bottom: 1px solid var(--border);
        }
        .logo { font-size: 1.5rem; font-weight: 700; letter-spacing: 1px; color: var(--text-main); }
        .logo span { color: var(--accent); }
        .nav-links { display: flex; gap: 2rem; list-style: none; align-items: center; }
        .nav-links a { color: var(--text-muted); text-decoration: none; transition: 0.3s; font-weight: 500; }
        .nav-links a:hover { color: var(--text-main); }
        .btn-admin {
            background: transparent; border: 1px solid var(--accent); color: var(--accent);
            padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; transition: 0.3s;
        }
        .btn-admin:hover { background: var(--accent); color: #fff; }

        /* Hero Section */
        .hero {
            padding: 5rem 8%; text-align: center;
            background: linear-gradient(180deg, rgba(15,17,21,0.5) 0%, var(--bg-main) 100%), 
                        url('https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=1200&q=80') center/cover;
        }
        .hero h1 { font-size: 3.5rem; font-weight: 700; margin-bottom: 1rem; }
        .hero p { color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin: 0 auto 2rem; }
        .badge-bar { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 1rem; }
        .badge { background: var(--bg-card); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem; }

        /* Sections General */
        section { padding: 4rem 8%; }
        .section-title { text-align: center; font-size: 2rem; margin-bottom: 2.5rem; }

        /* Speisekarte Grid */
        .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
        .menu-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden; transition: 0.3s;
        }
        .menu-card:hover { transform: translateY(-5px); border-color: var(--accent); }
        .menu-img { width: 100%; height: 180px; object-fit: cover; }
        .menu-content { padding: 1.5rem; }
        .menu-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
        .menu-title { font-size: 1.2rem; font-weight: 600; }
        .menu-price { color: var(--accent); font-weight: 700; font-size: 1.1rem; }
        .menu-desc { color: var(--text-muted); font-size: 0.9rem; }

        /* Info Container (Zeiten & Rezensionen) */
        .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
        .info-box { background: var(--bg-card); padding: 2rem; border-radius: var(--radius); border: 1px solid var(--border); }
        .info-box h3 { margin-bottom: 1rem; color: var(--accent); display: flex; align-items: center; gap: 0.5rem; }

        /* Rezensionen Carousel */
        .review-card { background: var(--bg-main); padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border-left: 3px solid var(--accent); }
        .review-author { font-weight: 600; font-size: 0.9rem; }
        .review-stars { color: #f59e0b; font-size: 0.8rem; }

        /* Admin Modal Dashboard */
        .admin-modal {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85); backdrop-filter: blur(5px); z-index: 2000;
            justify-content: center; align-items: center;
        }
        .admin-content {
            background: var(--bg-card); width: 90%; max-width: 650px; max-height: 90vh;
            overflow-y: auto; padding: 2rem; border-radius: var(--radius); border: 1px solid var(--border);
        }
        .form-group { margin-bottom: 1.2rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.9rem; }
        .form-group input, .form-group textarea {
            width: 100%; padding: 0.8rem; background: var(--bg-input); border: 1px solid var(--border);
            color: #fff; border-radius: 6px; font-size: 1rem;
        }
        .btn-submit {
            width: 100%; background: var(--accent); color: #fff; padding: 0.8rem;
            border: none; border-radius: 6px; font-weight: 600; cursor: pointer; transition: 0.3s;
        }
        .btn-submit:hover { background: var(--accent-hover); }
        .admin-item-list { margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1rem; }
        .admin-item { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; }

        footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.9rem; }
    </style>
</head>
<body>

    <!-- NAVIGATION -->
    <nav>
        <div class="logo">AQUILA <span>GENUSS</span></div>
        <ul class="nav-links">
            <li><a href="#speisekarte">Speisekarte</a></li>
            <li><a href="#info">Öffnungszeiten</a></li>
            <li><a href="#bewertungen">Bewertungen</a></li>
            <li><button class="btn-admin" onclick="toggleAdminModal()"><i class="fa-solid fa-lock"></i> Admin</button></li>
        </ul>
    </nav>

    <!-- HERO SECTION -->
    <header class="hero">
        <h1>Aquila Genuss ohne Grenzen</h1>
        <p>Echte neapolitanische Pizza & italienische Spezialitäten in Hochheim am Main.</p>
        <div class="badge-bar">
            <span class="badge"><i class="fa-solid fa-star" style="color:#f59e0b"></i> 4.6 / 5 Sterne (103+ Google Bewertungen)</span>
            <span class="badge"><i class="fa-solid fa-scissors"></i> Serviert mit Schere</span>
            <span class="badge"><i class="fa-solid fa-location-dot"></i> Edelstraße 2, Hochheim</span>
        </div>
    </header>

    <!-- SPEISEKARTE SECTION -->
    <section id="speisekarte">
        <h2 class="section-title">Unsere Speisekarte</h2>
        <div class="menu-grid" id="menu-container">
            <!-- Dynamische Gerichte werden hier geladen -->
        </div>
    </section>

    <!-- INFO & REZENSIONEN -->
    <section id="info" style="background: #13151a;">
        <div class="info-grid">
            <!-- Öffnungszeiten -->
            <div class="info-box">
                <h3><i class="fa-regular fa-clock"></i> Öffnungszeiten</h3>
                <p><strong>Dienstag:</strong> Geschlossen</p>
                <p><strong>Mittwoch - Donnerstag:</strong> 17:00 – 21:30</p>
                <p><strong>Freitag:</strong> 17:00 – 22:00</p>
                <p><strong>Samstag:</strong> 17:00 – 22:30</p>
                <p><strong>Sonntag - Montag:</strong> 17:00 – 21:30</p>
            </div>

            <!-- Google Bewertungen Highlights -->
            <div class="info-box" id="bewertungen">
                <h3><i class="fa-brands fa-google"></i> Google Bewertungen</h3>
                <div class="review-card">
                    <div class="review-stars">★★★★★</div>
                    <p>"Die neapolitanische Pizza ist unschlagbar! Der Teig und der Belag alles original."</p>
                    <span class="review-author">- Matthias G.</span>
                </div>
                <div class="review-card">
                    <div class="review-stars">★★★★★</div>
                    <p>"Die Pizza wird mit Schere serviert – geschmacklich ein absoluter Hammer!"</p>
                    <span class="review-author">- Frank M.</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ADMIN DASHBOARD MODAL -->
    <div class="admin-modal" id="adminModal">
        <div class="admin-content">
            <div style="display:flex; justify-size: space-between; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h2>Admin Dashboard</h2>
                <button onclick="toggleAdminModal()" style="background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer;">&times;</button>
            </div>

            <form id="add-item-form">
                <h3>Neues Gericht hinzufügen</h3>
                <br>
                <div class="form-group">
                    <label>Name des Gerichts</label>
                    <input type="text" id="item-title" required placeholder="z.B. Pizza Margherita">
                </div>
                <div class="form-group">
                    <label>Preis (€)</label>
                    <input type="text" id="item-price" required placeholder="z.B. 12,50">
                </div>
                <div class="form-group">
                    <label>Beschreibung / Zutaten</label>
                    <textarea id="item-desc" rows="2" placeholder="z.B. Tomatensauce, Fior di Latte, Basilikum"></textarea>
                </div>
                <div class="form-group">
                    <label>Bild hochladen</label>
                    <input type="file" id="item-img" accept="image/*" onchange="previewImage(event)">
                </div>
                <button type="submit" class="btn-submit">Gericht Speichern</button>
            </form>

            <div class="admin-item-list">
                <h3>Bestehende Gerichte</h3>
                <div id="admin-menu-list"></div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer>
        <p>&copy; 2026 Aquila Genuss ohne Grenzen – Edelstraße 2, 65239 Hochheim am Main</p>
    </footer>

    <!-- JAVASCRIPT FOR DYNAMIC DATA & STORAGE -->
    <script>
        // Standard-Menüdaten
        const defaultMenu = [
            { id: 1, title: "Pizza Margherita", price: "9,50 €", desc: "San Marzano Tomaten, Fior di Latte, frischer Basilikum, Olivenöl.", img: "https://images.unsplash.com/photo-1604382354936-07c5d9983bd3?auto=format&fit=crop&w=500&q=80" },
            { id: 2, title: "Pizza Diavola", price: "12,00 €", desc: "Scharfe italienische Salami, Fior di Latte, Chiliöl.", img: "https://images.unsplash.com/photo-1628840042765-356cda07504e?auto=format&fit=crop&w=500&q=80" },
            { id: 3, title: "Pizza Nutella Amore", price: "8,50 €", desc: "Süße Pizza mit Nutella – ideal zum Teilen als Nachtisch.", img: "https://images.unsplash.com/photo-1588315029754-2dd089d39a1a?auto=format&fit=crop&w=500&q=80" }
        ];

        let uploadedImageBase64 = "";

        // Speisekarte aus LocalStorage oder Standarddaten laden
        function getMenu() {
            const savedMenu = localStorage.getItem('aquila_menu');
            return savedMenu ? JSON.parse(savedMenu) : defaultMenu;
        }

        // Render-Funktion für Website
        function renderMenu() {
            const menuContainer = document.getElementById('menu-container');
            const adminContainer = document.getElementById('admin-menu-list');
            const menu = getMenu();

            menuContainer.innerHTML = "";
            adminContainer.innerHTML = "";

            menu.forEach(item => {
                // Frontend Cards
                menuContainer.innerHTML += `
                    <div class="menu-card">
                        <img src="${item.img}" class="menu-img" alt="${item.title}">
                        <div class="menu-content">
                            <div class="menu-header">
                                <span class="menu-title">${item.title}</span>
                                <span class="menu-price">${item.price}</span>
                            </div>
                            <p class="menu-desc">${item.desc}</p>
                        </div>
                    </div>
                `;

                // Admin Dashboard Einträge
                adminContainer.innerHTML += `
                    <div class="admin-item">
                        <span><strong>${item.title}</strong> (${item.price})</span>
                        <button onclick="deleteMenuItem(${item.id})" style="background:#dc2626; color:#fff; border:none; padding:0.3rem 0.6rem; border-radius:4px; cursor:pointer;">Löschen</button>
                    </div>
                `;
            });
        }

        // Bild-Upload in Base64 umwandeln
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function() {
                uploadedImageBase64 = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        // Gericht hinzufügen
        document.getElementById('add-item-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('item-title').value;
            const price = document.getElementById('item-price').value + " €";
            const desc = document.getElementById('item-desc').value;
            const img = uploadedImageBase64 || "https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=500&q=80";

            const currentMenu = getMenu();
            currentMenu.push({ id: Date.now(), title, price, desc, img });
            
            localStorage.setItem('aquila_menu', JSON.stringify(currentMenu));
            
            // Formular zurücksetzen
            this.reset();
            uploadedImageBase64 = "";
            renderMenu();
        });

        // Gericht löschen
        function deleteMenuItem(id) {
            let currentMenu = getMenu();
            currentMenu = currentMenu.filter(item => item.id !== id);
            localStorage.setItem('aquila_menu', JSON.stringify(currentMenu));
            renderMenu();
        }

        // Toggle Admin Modal
        function toggleAdminModal() {
            const modal = document.getElementById('adminModal');
            modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
        }

        // Initiales Laden
        renderMenu();
    </script>
</body>
</html>
